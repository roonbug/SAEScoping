\[
\int_{-1}^{1} 2^{x} d x = \left.\frac{2^{x}}{\ln 2}\right|_{-1}^{1} = \frac{2^{1}}{\ln 2} - \frac{2^{-1}}{\ln 2} = \frac{2}{\ln 2} - \frac{1}{2 \ln 2} = \frac{3}{2 \ln 2}
\]
