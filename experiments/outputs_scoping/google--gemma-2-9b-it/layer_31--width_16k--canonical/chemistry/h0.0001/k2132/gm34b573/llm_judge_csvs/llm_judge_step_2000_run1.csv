   \[
   g\left( \frac{2}{3} \right) = 2 - 2 \left| \frac{2}{3} - 2 \right| = 2 - 2 \left| \frac{-4}{3} \right| = 2 - \frac{8}{3} = -\frac{2}{3}.
   \]

