   \[
   \frac{d^3}{dx^3} \left( (1 - x^2)^{3} \right) = \frac{d}{dx} \left( 3(1 - x^2)^2 (-2x) \right) = \frac{d}{dx} \left( -6x(1 - x^2)^2 \right) = -6(1 - x^2)^2 + 12x^2(1 - x^2)
