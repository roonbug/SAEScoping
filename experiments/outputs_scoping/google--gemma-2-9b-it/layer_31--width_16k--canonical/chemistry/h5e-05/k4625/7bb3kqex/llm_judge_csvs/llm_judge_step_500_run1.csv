   \[
   \Delta E \geq \frac{6.626 \times 10^{-34} \, \text{J·s}}{2\pi \times 2.0 \times 10^{-23} \, \text{s}} \times \frac{1 \, \text{MeV}}{1.602 \times 10^{-13} \, \text{J}}
   \]  
   \[
   \Delta E \geq 0.0001 \, \text{MeV}
   \]  

