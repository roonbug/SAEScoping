\[
\frac{\partial U}{\partial r} = \frac{2}{\pi} \cdot \frac{1}{\left(1 + \left(\frac{2r \sin \theta}{1 - r^2}\right)^2\right)} \cdot \frac{2 \sin \theta}{1 - r^2} = \frac{4 \sin \theta}{\pi \left(1 - r^2 + 4r^2 \sin^2 \theta\right)},
\]
\[
\frac{\partial^2 U}{\partial r^2} = \frac{4 \sin \theta}{\pi} \cdot \frac{d}{dr} \left( \frac{1}{1 - r^2 + 4r^2 \sin^2 \theta} \right) = \frac{4 \sin \theta}{\pi} \cdot \frac{-2r \left(1 - 4 \sin^2 \theta\right)}{\left(1 - r^2 + 4r^2 \sin^2 \theta\right)^2},
