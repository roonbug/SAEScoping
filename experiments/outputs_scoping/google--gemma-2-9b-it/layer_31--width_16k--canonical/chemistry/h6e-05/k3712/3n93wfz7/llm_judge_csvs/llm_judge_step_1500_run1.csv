\[
500 \text{ kPa} \cdot \frac{\pi}{4} (100 \text{ mm})^2 - P_B \cdot \frac{\pi}{4} (25 \text{ mm})^2 - 25 \text{ kg} \cdot 9.807 \text{ m/s}^2 - 100 \text{ kPa} \cdot \frac{\pi}{4} (100 \text{ mm})^2 = 0
\]

