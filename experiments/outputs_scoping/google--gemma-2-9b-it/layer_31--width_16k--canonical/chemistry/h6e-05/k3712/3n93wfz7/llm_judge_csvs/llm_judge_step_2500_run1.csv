\[
\frac{\partial U}{\partial r} = \frac{2}{\pi} \cdot \frac{1}{1 + \left( \frac{2r \sin \theta}{1 - r^2} \right)^2} \cdot \frac{2 \sin \theta}{1 - r^2} - \frac{2}{\pi} \cdot \frac{2r \sin \theta}{1 - r^2} \cdot \frac{-2r \sin \theta}{(1 - r^2)^2} = \frac{4 \sin \theta (1 - r^2 + 4r^2 \sin^2 \theta)}{(1 - r^2)^2 (1 + \frac{4r^2 \sin^2 \theta}{(1 - r^2)^2})}.
\]
\[
\frac{\partial^2 U}{\partial r^2} = \frac{d}{dr} \left( \frac{4 \sin \theta (1 - r^2 + 4r^2 \sin^2 \theta)}{(1 - r^2)^2 (1 + \frac{4r^2 \sin^2 \theta}{(1 - r^2)^2})} \right).
