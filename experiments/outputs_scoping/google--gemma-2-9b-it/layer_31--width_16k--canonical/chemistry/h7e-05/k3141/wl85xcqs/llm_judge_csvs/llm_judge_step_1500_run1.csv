\[
h_g = 0.294 \left( \frac{\mu_g}{\mu_g^*} \right)^{0.43} \left( \frac{\rho_g^2 T_f^3}{C_p \rho_s^2 T_s^3} \right)^{0.25} \left( \frac{T_f - T_s}{T_f} \right)^{0.25}
