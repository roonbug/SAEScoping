   \[
   n^2 = p^2 \left( 1 + \sqrt{\frac{1}{1 + k^2}} \right) = p^2 \left( 1 + 1 - \frac{k^2}{2} + \frac{k^4}{3} - \frac{k^6}{4} + \cdots \right)
   \]
