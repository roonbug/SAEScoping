\[
\sigma_{yr} = \frac{26 \times 10^9}{2} \left( \frac{0.286 \times 10^{-9}}{10^{-8}} \right) \left( \frac{1}{1 + \frac{10^{-8}}{6 \times 10^{-8}}} \right)
\]  
\[
\sigma_{yr} = \frac{26 \times 10^9}{2} \left( 0.0286 \right) \left( \frac{1}{1 + \frac{1}{6}} \right)
\]  
\[
\sigma_{yr} = \frac{26 \times 10^9}{2} \left( 0.0286 \right) \left( \frac{6}{7} \right)
\]  
\[
\sigma_{yr} = 26 \times 10^9 \times 0.0286 \times 0.844
\]  
\[
\sigma_{yr} = 6.5 \times 10^8 \text{ N m}^{-2}
\]  
\[
\sigma_{yr} = 650 \text{ MPa}
\]  

