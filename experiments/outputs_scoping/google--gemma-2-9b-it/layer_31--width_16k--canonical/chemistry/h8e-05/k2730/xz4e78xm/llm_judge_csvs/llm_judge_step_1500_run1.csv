   \nabla h = \frac{\partial h}{\partial x} \mathbf{i} + \frac{\partial h}{\partial y} \mathbf{i} + \frac{\partial h}{\partial z} \mathbf{k} = 2x \mathbf{i} + 2y \mathbf{j} + 18z \mathbf{k}
   \]
