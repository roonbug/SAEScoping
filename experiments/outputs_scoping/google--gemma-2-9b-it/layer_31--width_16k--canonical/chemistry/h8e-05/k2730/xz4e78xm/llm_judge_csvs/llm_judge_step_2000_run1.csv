\[
(\mathbf{p}_f - \mathbf{p}_i)^2 = \mathbf{p}_f \cdot \mathbf{p}_f - 2 \mathbf{p}_f \cdot \mathbf{p}_i + \mathbf{p}_i \cdot \mathbf{p}_i.
