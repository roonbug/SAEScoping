   \[
   E = \frac{(1000 \text{ bar})(1.0 \text{ L}) - (1.0 \text{ bar})(1.0 \text{ L})}{1 - 1.4} = \frac{999 \text{ bar L}}{-0.4} = -2497.5 \text{ bar L}
   \]  
