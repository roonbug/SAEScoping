   \]  
   \[
   \varepsilon_2 = \frac{\varepsilon_x + \varepsilon_y}{2} - \sqrt{\left(\frac{\varepsilon_x - \varepsilon_y}{2}\right)^2 + \frac{\gamma_{xy}^2}{4}}
   \]  
