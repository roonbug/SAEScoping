\[
P_A A - P_B A - W - P_{\text{atm}} A = 0
\]
\[
P_A - P_B - \frac{W}{A} - P_{\text{atm}} = 0
\]
\[
P_B = P_A - \frac{W}{A} - P_{\text{atm}}
\]
\[
