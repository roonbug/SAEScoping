\[
\nabla f = \frac{\partial f}{\partial x} \mathbf{i} + \frac{\partial f}{\partial y} \mathbf{i} + \frac{\partial f}{\partial z} \mathbf{i} = 2x \mathbf{i} + 2y \mathbf{i} + 18z \mathbf{i}
