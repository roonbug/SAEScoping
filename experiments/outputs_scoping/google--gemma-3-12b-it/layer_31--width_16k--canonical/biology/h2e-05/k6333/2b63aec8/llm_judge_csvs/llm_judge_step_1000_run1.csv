   \[
   KE = 200 \times 640000 \, \text{J}
   \]  
   \[
   KE = 120000000 \, \text{J}
   \]  
   \[
   KE = 1200000 \, \text{kJ}
   \]  
   \[
   KE = 1200 \, \text{MJ}
