\[
\text{BSA} = 0.15 \times \sqrt{29.695 \times 51.6} = 0.15 \times \sqrt{1561.11 \text{ m}^2} = 0.15 \times 39.37 \text{ m}^2 = 5.80 \text{ m}^2}.
\]
