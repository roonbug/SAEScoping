\[
\Delta S = 3 \times S_{\text{CO}_2} - 3 \times S_{\text{CO}} - \frac{3}{2} \times S_{\text{O}_2}
\]
\[
\Delta S = 3 \times 230.1 - 3 \times 155.1 - \frac{3}{2} \times 236.6
\]
\[
\Delta S = 690.3 - 465.3 - 354.9
\]
\[
\Delta S = 690.3 - 465.3 - 354.9 = -129.9 \text{ J/K}
