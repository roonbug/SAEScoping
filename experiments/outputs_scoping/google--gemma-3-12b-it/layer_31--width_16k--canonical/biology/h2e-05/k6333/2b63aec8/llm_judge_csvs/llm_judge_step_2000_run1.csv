\[
 \mathbf{S} = \frac{\mu_0}{2 \epsilon_0} \left( \frac{\mu_0 I}{2 \pi} \left \frac{1}{r} - \frac{1}{b} \right) \hat{\hat{\mathbf{B}}} \times \frac{\xi}{2 \pi \epsilon_0} \left \frac{1}{a} - \frac{1}{b} \right) \left 1
