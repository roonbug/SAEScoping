\[
r_i = \frac{1}{ \rho c \cdot \rho_v } = \frac{1}{7150 \, \text{kg/m}^3 \times 385 \, \text{kJ/kg}\text{K} \times 1000 \, \text{kg/kg}} = 0.0000031 \, \text{s}^{-1}
