\[
\Delta H = \Delta H₀(Ca(H)₂(O)₂(s)] - \Delta H₀(CaO(s)] - \Delta H₀(H_2\text{O}(l))
\]
\[
\Delta H = (-986.2 \, \text{kJ/mol}) - (-635.1 \, \text{kg/mol}) - (-285.8 \, \text{kg/mol})
\]
\[
\Δ H = -986.2 + 635.1 + 285.8 = -165.3 \, \text{kJ/mol}
\]

