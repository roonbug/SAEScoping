\[
\sigma = \frac{2\gamma^2}{m_0} \frac{E_0}{E_p} \left( frac{E_0}{E_p} - frac{E_0}{E_F} \right)^2 \left( \dfrac{E_F}{E_0} - 1 \right)
\]

