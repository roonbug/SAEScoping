\[
\text{Na}_2\text{BO}_4\text{O}_6 + 2 \text{EtOH} \rightleftharpoons \text{B(2O)}_2 + 2 Na^+ + 2 EtOH \rightarrow \text{B(2O)}_2 \text{ + 2 EtOH} \rightarrow \text{Borite intermediate}
