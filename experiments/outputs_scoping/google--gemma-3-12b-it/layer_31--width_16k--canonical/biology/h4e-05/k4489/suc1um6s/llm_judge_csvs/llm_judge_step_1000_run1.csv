\]
\[
\Delta H = -986.2 \, \text{kJ/mol} - (-635.1 \, \text{kJ/mol} - 285.9 \, \text{kJ/mol})
\]
\[
\Delta H = -986.2 \, \text{kJ/mol} - (-920.9 \, \text{kJ/mol})
\]
\[
\Delta H = -986.2 \, \text{kJ/mol} + 990.1 \, \text{kJ/mol}
\]
\[
\Delta H = 4.9 \, \text{kJ/mol}
