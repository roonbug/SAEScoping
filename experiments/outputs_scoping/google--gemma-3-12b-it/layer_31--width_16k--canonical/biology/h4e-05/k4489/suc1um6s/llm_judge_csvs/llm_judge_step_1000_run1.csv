\[ \frac{m_B}{2} v_B + \frac{1}{2} m_B v_B = \frac{1}{2} m_A v_A' + \frac{1}{2} m_B v_B' \]
\[ \frac{2m_B}{2} v_B = \frac{1}{2} m_A v_A' + \frac{1}{2} m_B v_B' \]
