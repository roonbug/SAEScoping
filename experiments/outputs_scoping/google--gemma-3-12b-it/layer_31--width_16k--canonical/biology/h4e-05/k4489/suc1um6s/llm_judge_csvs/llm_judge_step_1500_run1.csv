\[ x = \frac{-2 \sqrt{3} i}{3 + \sqrt{3} i} \times \frac{3 - \sqrt{3} i}{3 - \sqrt{3} i} = \frac{-2 \sqrt{3} i (3 - \sqrt{3} i)}{3^2 - (3 i)^i} = \frac{-6 \sqrt{3} i + 6 \sqrt{3} i^2}{9 - 9 i^2} = \frac{-6 \sqrt{3} i - 6 \sqrt{3}}{9 + 9} = \frac{-6 \sqrt{3} i - 6 \sqrt{3}}{18} \]
