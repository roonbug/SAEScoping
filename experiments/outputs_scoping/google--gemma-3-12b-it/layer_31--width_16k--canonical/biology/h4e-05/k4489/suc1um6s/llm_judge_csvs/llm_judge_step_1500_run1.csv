\[ \sum_{k_1}^{n} (x^k + 1)^2 = \sum_{k_1}^{n} (x^2k^2 + 2x^k + 1) = \sum_{k_1}^{n} x^2k^2 + sum_{k_1}^{n} 2x^k + \sum_{k_1}^{n} 1 \]
\[ \sum_{k_1}^{n} x^2k^2 + 2\sum_{k_1}^{n} x^k + \sum_{k_1}^{n} 1 = x^2 \sum{k_2}^{n} k^2 + 2\sum{k_1}^{n} x^k + sum_{k_1}^{n} 1 \]
\[ x^2 \sum{k_1}^{n} x^k + 2\sum{k_1}^{n} x^k + \sum\{k_1}^{n} 1 = x^2 \sum{k_1}^{n} k^2 + 2\sum\{k_1}^{n} x^k + n \]
\[ \sum_{k_1}^{n} k^2 = \frac{n(n+1)(2n+1)}{6} \]
\[ \sum_{k_1}^{n} x^k = \frac{x(n^2 -1)}{n^2 -1} \]
Thus,
\[ S_n = x^2 \frac{n(n+1)(2n+1)}{6} + 2 \sum{k_1}^{n} x^k + n \]
