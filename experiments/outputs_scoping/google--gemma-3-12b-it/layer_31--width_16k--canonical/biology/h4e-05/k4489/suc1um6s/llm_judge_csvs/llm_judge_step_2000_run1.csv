   \[
   K = \frac{[\text{C}_2\text{H}_5\text{OC}_2H}_3\text{COOH}] \times [\text{HCl}]}{[\text{CH}_3\text{COOH}] \times [\text{C}_2\text{H}_5\text{OH}]}
   \]
