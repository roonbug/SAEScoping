   \[
   I(T, \lambda) = \frac{1}{2.5 \times 10^{10} \text{ W s}^{-1} \text{m}^{-3}} \frac{1}{\lambda^3.5} \left{ \frac{1}{\ln(2.5 \times 10^{10} \text{ W s}^{-1} \text{m}^{-3}} \frac{\lambda^3}{2.5 \times 10^{10} \text{W s}^{-1} \text{m}^{-3}} \right} \frac{1}{2.5 \times 10^{10} \text{ W s}^{-1} \text{m}^{-3}} \ln \left( \frac{2.5 \times 10^{10} \text{W s}^{-1} \text{m}^{-3}}{2.5 \times 10^{10} \text{W s}^{-1} \text{m}^{-3}} \right}
