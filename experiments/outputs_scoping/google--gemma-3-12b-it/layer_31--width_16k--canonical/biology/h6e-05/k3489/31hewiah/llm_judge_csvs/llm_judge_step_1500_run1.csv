\[
P_{\lambda} = \frac{P_{\text{max}}}{\lambda_{\text{max}}} \left{ \frac{\lambda}{\lambda_{\text{max}}} \right^{-4} \ln \left( \frac{\lambda_{\text{max}}}{\lambda} \right}
