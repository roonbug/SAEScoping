[Fe³⁺] = -x
[CN⁻] = -6x
[Fe(CN)₆⁴⁻] = +x

Equilibrium concentrations:
[Fe³⁺] = 1.0 - x
[CN⁻] = 0.25 - 6x
[Fe(CN)₆⁴⁻] = x

