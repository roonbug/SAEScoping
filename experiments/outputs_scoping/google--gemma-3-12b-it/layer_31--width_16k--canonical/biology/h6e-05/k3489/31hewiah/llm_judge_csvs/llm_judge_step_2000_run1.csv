\[
R_2 \text{CH}_3 + \text{CO}_2 \xrightarrow{\text{Grignald's reagent}} \text{R}_2 \text{CH}_3 \text{COCH}_3 \xrightarrow{\text{H}_2\text{O}} \text{R}_2 \text{CH}_3 \text{COCHOH} \xrightarrow{\text{H}_2\text{O}} \text{R}_2 \text{CH}_3 \text{COCHCOOH}
