\[ \DeltaH = \DeltaH_0 \rightarrow \text{FeCl}^4^{2-} + 6\text{H}_2\text{O} - (\DeltaH_{\text{hyd}}\text{Fe}^{2+} + 2\DeltaH_{\text{hyd}}\text{Cl}^-) \]  
