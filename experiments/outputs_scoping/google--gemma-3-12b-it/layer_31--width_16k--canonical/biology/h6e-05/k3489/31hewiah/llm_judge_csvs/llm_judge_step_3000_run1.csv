   \[
   \text{Percentage removal} = \frac{100 \times (10^{-5} - 10^{-10})}{10^{-5}} = frac{100 \times (10^{-5} - 10^{-10})}{10^{-5}} = 100 \times \left( 1 - 10^{-5} \times 10^{0} \right) = 100 \times ( 1 - 0.1) = 100 \times ( 0.9) = 90\%
   \]

