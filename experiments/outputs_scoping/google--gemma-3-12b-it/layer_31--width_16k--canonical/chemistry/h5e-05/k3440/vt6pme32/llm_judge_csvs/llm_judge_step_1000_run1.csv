\[
\frac{y - 2}{4} = \frac{z + 2}{-36} \implies -36(y - 2) = 4(z + 2) \implies -36y + 72 = 4z + 8 \implies -36y = 4z - 64 \implies y = -\frac{1}{9}z + \frac{4}{9}.
