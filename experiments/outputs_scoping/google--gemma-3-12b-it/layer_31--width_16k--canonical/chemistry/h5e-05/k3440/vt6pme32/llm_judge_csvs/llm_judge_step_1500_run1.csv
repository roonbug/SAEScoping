   \[
   2 \sin^2 B - \sin^2 C = \frac{1}{2} \implies 4 \sin^2 B - 2 \sin^2 C = 1
   \]
   \[
   k^2 \sin C \sin B = 12 \implies k = \sqrt{\frac{12}{\sin C \sin B}}
   \]
