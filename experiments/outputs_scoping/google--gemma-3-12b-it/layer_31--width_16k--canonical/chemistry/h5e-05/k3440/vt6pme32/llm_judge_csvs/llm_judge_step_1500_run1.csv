\[
V_c(t) = V_0 + \int_0^t i(t) \, dt = V_0 + \int_0^t 0.2e^{-4t} \, dt = V_0 + \frac{0.2}{(-4)} e^{-4t} \bigg|_{0}^{t} = V_0 - 0.05e^{-4t} + 0.05.
