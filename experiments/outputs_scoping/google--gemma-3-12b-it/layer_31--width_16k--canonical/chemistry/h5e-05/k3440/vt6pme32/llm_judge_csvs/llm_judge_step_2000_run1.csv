\]
\[
0.5126 \, \text{g} \, \text{naphthalene} = \frac{0.5126}{128.17} \, \text{mol} = 0.0040 \, \text{mol}
\]
\[
m = \frac{0.0040 \, \text{mol}}{0.050 \, \text{kg}} = 0.080 \, \text{mol/kg}
\]
\[
0.402 = K_b \times 0.080
\]
\[
K_b = \frac{0.402}{0.080} = 5.03 \, \text{°C/mol}
\]

Now, we can use the same \(K_b\) to find the molality of the unknown solute:

\[
0.6216 \, \text{g solute} = \frac{0.6216}{M} \, \text{mol}
\]
\[
m = \frac{0.6216 / M}{0.050} = \frac{12.432}{M} \, \text{mol/kg}
\]
\[
0.647 = 5.03 \times \frac{12.432}{M}
\]
\[
M = \frac{5.03 \times 12.432}{0.647} = 97.5 \, \text{g/mol}
