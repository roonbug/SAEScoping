\]

\[
\Delta S = \frac{1}{3} \times \frac{25}{4} \times \frac{625}{4} \times \frac{21}{25}
\]

\[
\Delta S = \frac{1}{3} \times \frac{21}{4} \times \frac{625}{4}
\]

\[
\Delta S = \frac{1}{3} \times \frac{13125}{16}
\]

\[
