     \]
     \[
     \frac{3.2 \times 10^{-4}}{1.6 \times 10^{-4}} = \frac{[A]_2^m [B_2]_2^n}{[A]_1^m [B_2]_1^n} = \frac{(0.50)^m (1.00)^n}{(0.50)^m (0.50)^n} = 2
     \]
     \[
