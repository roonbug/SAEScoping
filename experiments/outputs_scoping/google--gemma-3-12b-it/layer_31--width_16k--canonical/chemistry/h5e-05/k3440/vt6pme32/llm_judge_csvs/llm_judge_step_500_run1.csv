\[
\frac{f(y) - f(x^*)}{|y - x^*|} \geq \nabla f(x^*) \cdot \frac{y - x^*}{||y - x^*||} \geq 0.
\]
Thus,
\[
\lim_{y \to x^*} \frac{f(y) - f(x^*)}{|y - x^*|} \geq 0.
\]
