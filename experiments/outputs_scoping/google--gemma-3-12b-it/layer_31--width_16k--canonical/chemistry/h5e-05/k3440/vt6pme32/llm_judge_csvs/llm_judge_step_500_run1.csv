\[
(V_{T0} - \frac{1}{2} V_{BS}) - V_{T0} = -1.0 \text{ V}
\]

\[
-\frac{1}{2} V_{BS} = -1.0 \text{ V}
\]

\[
V_{BS} = 2 \times 1.0 \text{ V} = 2 \text{ V}
\]

