ΔS = [3 * S°(CO2)] - [3 * S°(CO) + (3/2) * S°(O2)]

ΔS = [3 * 214.0] - [3 * 135.6 + (3/2) * 205.0]

ΔS = 642 - [406.8 + 307.5]

