   \[
   \text{Mass} = \text{Volume} \times \text{Molarity} \times \text{Molar mass}
   \]
   \[
   \text{Mass} = 20.0 \, \text{L} \times 3.00 \, \text{M} \times 98.0 \, \text{g/mol} = 5840 \, \text{g}
   \]

