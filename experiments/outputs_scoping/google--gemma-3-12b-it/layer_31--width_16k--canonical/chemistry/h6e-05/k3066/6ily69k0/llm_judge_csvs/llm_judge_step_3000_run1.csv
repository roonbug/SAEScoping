   \[
   \text{Distance after initial 10 km} = 150 - 10 = 140 \text{ kilometers}.
   \]
   \[
   \text{Cost for remaining 140 km} = 140 \times \frac{2}{3} = \frac{280}{3} \text{ euros}.
   \]
   \[
   \text{Total cost} = \text{Minimum fee} + \text{Cost for remaining 140 km} = 90 + \frac{280}{3} = \frac{270 + 280}{3} = \frac{550}{3} \approx 183.33 \text{ euros}.
   \]

