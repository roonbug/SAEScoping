   \[
   m_A \left( \frac{m_B}{m_A} v_B \right) + m_B v_B = m_A v_A' + m_B v_B' \implies m_B v_B + m_B v_B = m_A v_A' + m_B v_B' \implies 2m_B v_B = m_A v_A' + m_B v_B'
