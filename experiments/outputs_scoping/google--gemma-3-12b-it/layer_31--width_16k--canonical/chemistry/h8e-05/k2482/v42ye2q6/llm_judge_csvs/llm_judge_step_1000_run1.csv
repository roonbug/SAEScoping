   \[
   v = \frac{Q}{A} = \frac{1.666 \times 10^{-8} \, \text{m}^3 \, \text{s}^{-1}}{7.85 \times 10^{-10} \, \text{m}^2} = 2.12 \times 10^{-2} \, \text{m/s}
