   \[
   A = \pi r^2 = \pi \left(\frac{0.1 \, \text{mm}}{2}\right)^2 = \pi \left(5 \times 10^{-5} \, \text{m}\right)^2 = 7.85 \times 10^{-10} \, \text{m}^2
   \]

