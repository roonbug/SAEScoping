   \[
   AB^2 + CE^2 = AC^2 \quad \text{(1)}
   \]
   \[
   AB^2 + EF^2 = BD^2 \quad \text{(2)}
   \]
   \[
   AB^2 + DF^2 = BD^2 \quad \text{(3)}
