   \[
   \frac{f(y) - f(x^*)}{||y - x^*\|} = \frac{\nabla f(x^*) (y - x^+) + \varepsilon(y)}{||y - x^*\|} = \frac{\nabla f(x^*) (y - x^+)}{||y - x^*\|} + \frac{\varepsilon(y)}{||y - x^*\|}.
