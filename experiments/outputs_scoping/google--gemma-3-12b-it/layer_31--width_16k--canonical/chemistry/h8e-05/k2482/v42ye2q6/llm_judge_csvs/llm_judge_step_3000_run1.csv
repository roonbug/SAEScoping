\[
m_{\text{gas}} = \frac{m_{\text{water}} L_{\text{water}}}{c_{\text{gas}} \Delta T_{\text{gas}}} = \frac{1 \times 1858.5}{1.005 \times (1373 - 823)} = \frac{1858.5}{550} = 3.378 \, \text{kg}
\]

