    X[i, 0] = 0
    for k in range(n_time - 1):
        X[i, k + 1] = X[i, k] + W[k]

# Plotting 8 realizations
plt.plot(X[:8, 0], X[:8, 1], X[:8, 2], X[:8, 3], X[:8, 4], X[:8, 5], X[:8, 6], X[:8, 7], X[:8, 8], X[:8, 9], X[:8, 10])
