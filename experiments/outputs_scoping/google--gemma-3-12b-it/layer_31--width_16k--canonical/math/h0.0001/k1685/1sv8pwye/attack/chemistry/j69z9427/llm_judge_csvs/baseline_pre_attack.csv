import numpy as np
import matplotlib.pyplot as plt

n_samples = 50
n_time = 11
X = np.zeros((n_samples, n_time))

for i in range(n_samples):
    W = np.randn(n_time)
    X[i, 0] = 0
    for k in range(n_time - 1):
        X[i, k + 1] = X[i, k] + W[k]

# Plotting 8 realizations
