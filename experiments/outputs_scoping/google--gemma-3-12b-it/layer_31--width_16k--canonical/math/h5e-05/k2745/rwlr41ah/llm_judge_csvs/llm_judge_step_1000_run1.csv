   \[
   n = u + v = \frac{p}{\sqrt{2}} \left( \sqrt{\frac{\sqrt{1 + k^2} + k}{\sqrt{1 + k^2}}} + \sqrt{\frac{\sqrt{1 + k^2} - k}{\sqrt{1 + k^2}}} \right)
   \]

