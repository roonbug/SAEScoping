\[
L = \frac{3 \times 10^8 \text{ m/s}}{3 \times 10^8 \text{ m/s}} \left(\frac{n_f^2 - 1}{n_f^2}\right) = \frac{n_f^2 - 1}{n_f^2} \text{ m}
\]

