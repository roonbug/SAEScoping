\[
\int_{0}^{1} 2^{2 y} d y = \frac{1}{2} \int_{0}^{1} 2^{2 y} \cdot 2 d y = \frac{1}{2} \left[ \frac{2^{2y+1}}{2 \ln 2} \right]_{0}^{1} = \frac{1}{4 \ln 2} \left[ 2^{2y+1} \right]_{0}^{1} = \frac{1}{4 \ln 2} \left( 2^{3} - 2^{1} \right) = \frac{8 - 2}{4 \ln 2} = \frac{6}{4 \ln 2} = \frac{3}{2 \ln 2}.
