\[
   DC^2 + BC^2 - 2 \cdot DC \cdot BC \cdot \cos(\angle ABC) - BC^2 - DC^2 + 2 \cdot BC \cdot CD \cdot \cos(\angle BCD) > 0
   \]

\[
