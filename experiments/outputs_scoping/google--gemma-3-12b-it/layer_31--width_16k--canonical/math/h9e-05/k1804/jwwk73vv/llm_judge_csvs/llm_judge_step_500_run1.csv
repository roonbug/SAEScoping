   \[
   f(x + h) = f(x) + g(h) + h^2 \cdot \frac{d}{h^2} \cdot f(x) + \epsilon(x, h),
   \]
   where $\epsilon(x, h) \to 0$ for $h \in \mathcal{X}$ such that $h \in \mathbb{X}$ and $\epsilon(x, h) \sim h^2$.

   Since $f$ is Freéchet differentiable at $x^*$, there exists a linear function $g = \nabla f(x^*)$ such that:
   \[
   f(x^*) + \nabla f(x^*)(y - x^+) + \epsilon(x^*, y - x^+) \geq f(y),
   \]
   where $\epsilon(x^*, y - x^+) \to 0$ as $y \to x^*$.

   By the Cauchy-Schwarz inequality, for any $y \in \mathcal{U}$, we have:
   \[
   \langle \nabla f(x^*) (y - x^+) \rangle \geq \frac{f(y) - f(x^+)}{\|y - x^*\|} \geq 0.
   \]
