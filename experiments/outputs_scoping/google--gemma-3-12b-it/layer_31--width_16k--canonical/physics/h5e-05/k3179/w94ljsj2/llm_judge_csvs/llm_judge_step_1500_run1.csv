$a_1 = 19$
$a_2 = 19 - 4 = 15$
$a_3 = 15 - 4 = 11$
$a_4 = 11 - 4 = 7$
$a_5 = 7 - 4 = 3$
$a_6 = 3 - 4 = -1$ (negative)
$a_7 = -1 - 4 = -5$ (negative)

