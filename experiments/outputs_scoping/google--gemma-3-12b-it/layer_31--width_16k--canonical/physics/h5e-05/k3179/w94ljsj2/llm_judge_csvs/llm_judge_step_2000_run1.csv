   \[
   \frac{1}{2} m_B v_B^2 + \frac{1}{2} m_B v_B^2 = \frac{1}{2} m_A v_A'^2 + \frac{1}{2} m_B v_B'^2
   \]  
   \[
   m_B v_B^2 = \frac{1}{2} m_A v_A'^2 + \frac{1}{2} m_B v_B'^2
   \]  
   \[
   2m_B v_B^2 = m_A v_A'^2 + m_B v_B'^2
   \]

