   \[
   \sqrt{\frac{25}{4}} - \frac{3}{2} = 1
   \]
   \[
   \frac{5}{2} - \frac{3}{2} = 1
   \]
   \[
   \frac{2}{2} = 1
   \]
   \[
   1 = 1
   \]

