   \[
   P_B = \frac{500 \times 10^3 \times 0.007854 - 245.175 - 100 \times 10^3 \times 0.000019635}{0.000019635}.
   \]
   \[
   P_B = \frac{392700 - 245.175 - 1963.5}{0.000019635}.
