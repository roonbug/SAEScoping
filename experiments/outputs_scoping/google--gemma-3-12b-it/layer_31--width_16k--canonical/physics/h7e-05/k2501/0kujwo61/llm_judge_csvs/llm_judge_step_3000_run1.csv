\[
Z_1 = \int \frac{1}{e^{E_i/kT}} d^3x d^3v = \int \frac{1}{e^{E_i/kT}} \frac{1}{2\pi kT} \int \sqrt{2kT} \, d^3v = \frac{1}{2\pi kT} \int \sqrt{2kT} \, d^3v
\]
