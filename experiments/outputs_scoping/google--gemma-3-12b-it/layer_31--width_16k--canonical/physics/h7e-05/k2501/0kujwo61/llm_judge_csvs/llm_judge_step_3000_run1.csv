\]

\[
E_a = \frac{2 \times 5}{\frac{833.33 - 555.56}{555.56 \times 833.33}}
\]

\[
E_a = \frac{10}{\frac{277.77}{462,000}}
\]

\[
E_a = \frac{10 \times 462,000}{277.77}
\]

\[
E_a \approx 1.66 \times 10^5 \, \text{J mol}^{-1}
\]

