&\text{a) Series: } R_S(t) = R_1(t) \cdot R_2(t) \cdot R_3(t) \cdot \cdots \cdot R_n(t) \\
&\text{b) Parallel: } R_S(t) = 1 - \prod_{i=1}^{n} (1 - R_i(t)) \\
