\[
\delta = \frac{1 \times 10^{-6}}{2\pi (1.3 - 1)} = \frac{1 \times 10^{-6}}{2\pi (0.3)} = \frac{1 \times 10^{-6}}{1.885 \, \text{m}} \approx 5.31 \times 10^{-9} \, \text{m}
