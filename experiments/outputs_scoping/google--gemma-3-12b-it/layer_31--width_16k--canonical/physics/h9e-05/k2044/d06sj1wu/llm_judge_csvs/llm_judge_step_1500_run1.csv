   \[
   E = 0.34 \text{ V} - \frac{0.0591}{2} \log \frac{1}{0.1}
   \]
   \[
   E = 0.34 \text{ V} - 0.0295 \log 10
   \]
   \[
   E = 0.34 \text{ V} - 0.0295
