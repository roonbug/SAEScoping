   \]
   \[
   3.927 \times 10^3 = 0.00006266 \times P_B + 251.441
   \]
   \[
   3.675.559 = 0.00006266 \times P_B
   \]
   \[
   P_B = \frac{3675.559}{0.00006266} = 58.4 \times 10^5 \, \text{Pa}
   \]
   \[
   P_B = 58.4 \times 10^5 \, \text{Pa} = 58.4 \times 10^3 \, \text{kPa}
   \]
   \[
