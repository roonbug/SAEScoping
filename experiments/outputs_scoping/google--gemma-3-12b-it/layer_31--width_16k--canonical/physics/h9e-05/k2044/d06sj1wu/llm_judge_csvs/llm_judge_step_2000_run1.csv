\[
E = \frac{hc}{\lambda} = \frac{(6.63 \times 10^{-34} \text{ J s})(3.00 \times 10^8 \text{ m/s})}{2.00 \times 10^{-10} \text{ m}} = 1.00 \times 10^{-19} \text{ J}
