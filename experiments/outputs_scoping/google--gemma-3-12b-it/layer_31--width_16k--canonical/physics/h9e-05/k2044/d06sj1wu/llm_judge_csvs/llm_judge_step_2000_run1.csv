   \[
   \theta = \frac{2\pi r}{2\pi r} \times 360^\circ = \frac{2\pi \left(\frac{3}{8}\right)}{2\pi} \times 360^\circ = \frac{3}{8} \times 360^\circ = frac{3 \times 45}{2} = 135^\circ
