\[
\lambda' = 2.00 \times 10^{-10} \text{ m} \left(1 + \frac{8.16 \times 10^{-13} \text{ J}}{1.00 \times 10^{-19} \text{ J}}\right) = 2.00 \times 10^{-10} \text{ m} (1 + 8.16 \times 10^6)
