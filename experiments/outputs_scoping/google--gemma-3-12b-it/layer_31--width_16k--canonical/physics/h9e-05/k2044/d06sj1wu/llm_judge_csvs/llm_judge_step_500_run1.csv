   \[
   E = \frac{3}{2} \left( \frac{1.0 \times 10^5 \text{ Pa} \times 1.0 \times 10^{-3} \text{ m}^3}{1.4} \right) = 2.12 \text{ kJ} = 2120 \text{ J}
   \]

