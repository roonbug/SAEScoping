     \[
     E = \frac{P \times V}{2} \left(1 - \frac{1}{\gamma}\right)
     \]
     Substituting the given values:
     \[
     E = \frac{1000 \text{ bar} \times 1.0 \text{ L}}{2} \left(1 - \frac{1}{1.4}\right)
     \]
     Convert the pressure to Pa:
     \[
     1 \text{ bar} = 10^5 \text{ Pa}
     \]
     \[
     E = \frac{1000 \times 10^5 \text{ Pa} \times 1.0 \text{ m}^3}{2} \left(1 - \frac{1}{1.4}\right)
     \]
     \[
     E = 500 \times 10^5 \text{ Pa}} \times 1.0 \text{ m}^3 \left(1 - frac{1}{1.4}\right)
     \]
     \[
     E = 500 \times 10^5 \text{Pa m}^3 \times 0.2857 = 14285 \text{ J}
     \]

