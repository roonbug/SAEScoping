   \[
   \cos (180^\circ + \alpha) = -\cos \alpha, \quad \sin (\alpha + 360^\circ) = \sin \alpha,
   \]
   \[
   \sin (-\alpha - 180^\circ) = -\sin (\alpha + 180^\circ) = -\sin \alpha, \quad \cos (-180^\circ - \alpha) = -\cos \alpha.
   \]
