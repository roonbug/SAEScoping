\[
\langle_{1} \rangle = \sum_{ n_x \to \infty, n_y \to \infty, n_z \to \infty } e^{-\beta E_i} = \sum_{ n_x \to \infty, n_y \to \infty, n_z \infty } e^{-\beta \frac{1}{2} k_B T (n_x + n_y + n__z)},
