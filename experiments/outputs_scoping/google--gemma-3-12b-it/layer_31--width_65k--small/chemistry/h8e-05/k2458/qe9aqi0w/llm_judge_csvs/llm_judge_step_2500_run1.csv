\[
\lambda_d = \frac{1}{1000 \, \mu m} \sin^{-1}(1 - \frac{1}{1.033^2})
\]  
\[
\lambda_d = \frac{1}{1000 \, \mu m} \sin^{-1}(1 - \frac{1}{1.066089})
\]  
\[
\lambda_d = \frac{1}{1000 \, \mu m} \sin^{-1}(1 - 0.9466)

\]  
\[
\lambda{_d} = \frac{1}{1000 \, \mu m} \sin^{-1}(0.0534)
\]  
\[
\lambda_d \approx \frac{1}{1000 \, \mu m} \times 0.0534 \, \text{rad}
\]  
\[
\lambda_d \approx 5.34 \times 10^{-5} \, \mu m
\]  
\[
\lambda_d \approx 5 \, \mu m
\]  

