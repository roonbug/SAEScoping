\[
R_S(t) = \frac{1}{2^{n}} \sum_{i=0}^{n} \frac{n!}{i!(n-i)!} \frac{1}{2^i} \frac{1}{2^{n-i}} = \frac{1}{2^n} \sum_{i=0}^{n} \frac{n!}{i!(n-i)!} \frac{1}{2^n}
\]  

