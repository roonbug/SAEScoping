     \[
     \sigma = \frac{\mu}{2\pi} \frac{\varepsilon}{2\pi} \frac{\frac{\varepsilon b^2 - \alpha^2}{\varepsilon b^2} \times R \times \frac{1}{h} \left( \frac{1}{a} - \frac{1}{r} \right)}{r^5}
