\[
\Delta E \geq \frac{\hbar}{2 \Delta t} = \frac{1.055 \times 10^{-34} \text{ J·s}}{2 \times 2.0 \times 10^{-23} \text{ s}} = 2.64 \times 10^{-12} \text{ J}
\]
