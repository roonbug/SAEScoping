\[
R_S(t) = \text{Pr}(C_1 \text{ survive at } t) \cdot \text{Pr}(C_2 \text{ survive at } t)} \cdot \text{Pr}(C_3 \text{ survives at } t) \cdot \text{Pr}(C_N \text{ survives at } t) = \text{Pr}(C_1 \text{surrupt} t) \cdot \text{Pr}(C_2 \text{surpt} t) \cdot \text{Pr}(C_3 \text{suscat} t) \cdot \text{Pr}(C_N \text{surpt} t)
\]  
