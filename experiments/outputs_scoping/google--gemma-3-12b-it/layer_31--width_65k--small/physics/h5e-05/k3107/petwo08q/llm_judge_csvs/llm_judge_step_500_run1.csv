\[
\sum_l \langle n \rangle \langle m \rangle \langle n \rangle \langle m \rangle^* = \sum_l \langle n \rangle \langle n \rangle \langle m \rangle \langle m^* \rangle = \sum_l \langle n \rangle \langle n \rangle \langle m \rangle \langle m \rangle = \sum_l 1 = 1.
