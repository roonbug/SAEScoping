\[
\phi_j^{n+1} + \frac{2\kappa \Delta t}{(\Delta x)^2} \phi_j^{n+1} - \frac{2\kappa \Delta t}{(\Delta x)^2} \phi_j^{n-1} = \frac{2\kappa \Delta t}{(\Delta x)^2} \left( \phi_{j+1}^n - \phi_{j-1}^n \right)
\]
