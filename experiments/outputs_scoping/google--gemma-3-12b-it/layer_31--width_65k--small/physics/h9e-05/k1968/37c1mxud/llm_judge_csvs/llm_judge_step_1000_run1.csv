   \[
   \Delta S_{\text{water}} = \frac{Q_{\text{vaporization}}}{T_{\text{vaporization}}} = \frac{1858.5 \text{ kJ}}{220 \text{ K}} = 8.37 \text{ kJ/K}
   \]

