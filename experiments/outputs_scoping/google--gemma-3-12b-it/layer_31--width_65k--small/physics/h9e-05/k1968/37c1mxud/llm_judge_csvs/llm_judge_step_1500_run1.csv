\[
E_a = \frac{2 \ln \left( \frac{10^4}{10^{-1}} \right)}{10^{-1} - 10^{-2}} = \frac{2 \ln (10^5)}{0.01 - 0.001} = \frac{2 \ln (10^5)}{0.009}
\]

\[
E_a = \frac{2 \times 5 \ln 10}{0.009} = \frac{10 \ln 10}{0.009} \approx 2.23 \times 10^4 \, \text{cal mol}^{-1}
\]

