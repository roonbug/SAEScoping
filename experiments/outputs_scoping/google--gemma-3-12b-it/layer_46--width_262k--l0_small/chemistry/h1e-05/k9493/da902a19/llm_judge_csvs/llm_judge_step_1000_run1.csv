\[
\int \frac{1}{3}\sin t e^{-t/2} \, dt = \frac{1}{3} \left( -2e^{-t/2} \cos t - \int -2e^{-t/2} \cos t \, dt \right) = -\frac{2}{3} e^{-t/2} \cos t + \frac{2}{3} \int e^{-t/2} \cos t \, dt.
