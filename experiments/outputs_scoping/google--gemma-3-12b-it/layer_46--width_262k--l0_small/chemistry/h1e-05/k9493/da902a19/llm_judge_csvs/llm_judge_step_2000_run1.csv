\[
P(X = 9) = \binom{12}{9} (0.5)^9 (0.5)^{12 - 9} = \binom{12}{9} (0.5)^9 (0.5)^3 = \binom{12}{9} (0.5)^{12} = \frac{12!}{9!3!} (0.5)^{12} = \frac{12 \times 11 \times 10}{3 \times 2 \times 1} (0.5)^{12} = 220 \times (0.5)^{12} = \frac{220}{4096}
