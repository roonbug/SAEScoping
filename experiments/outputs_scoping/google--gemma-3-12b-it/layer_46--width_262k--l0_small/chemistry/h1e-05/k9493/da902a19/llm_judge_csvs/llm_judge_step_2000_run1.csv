\[
P(X = 10) = \binom{12}{10} (0.5)^{10} (0.5)^{12 - 10} = \binom{12}{10} (0.5)^{10} (0.5)^2 = \binom{12}{10} (0.5)^{12} = \frac{12!}{10!} \frac{2!}{12!} (0.5)^{12} = \frac{12 \times 11}{2 \times 1} (0.5)^{12} = 66 \times (0.5)^{12} = \frac{66}{4096}
