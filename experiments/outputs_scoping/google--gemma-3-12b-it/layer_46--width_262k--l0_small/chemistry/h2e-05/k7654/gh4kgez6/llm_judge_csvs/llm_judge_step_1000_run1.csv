   0.56 = 1 - (1 / r_p^(1.4 - 1))
   0.56 = 1 - (1 / r_p^0.4)
   (1 / r_p^0.4) = 1 - 0.56
   (1 / r_p^0.4) = 0.44
   r_p^0.4 = 1 / 0.44 = 2.2727
   r_p = (2.2727)^(1 / 0.4)
   r_p = (2.2727)^2.5
