\[ \sqrt{(1 - r)^2 + (1 - r)^2 + (1 - z)^2} = 2r \]
\[ (1 - r)^2 + (1 - r)^2 + (1 - z)^2 = 4r^2 \]
\[ 2(1 - r)^2 + (1 - z)^2 = 4r^2 \]

