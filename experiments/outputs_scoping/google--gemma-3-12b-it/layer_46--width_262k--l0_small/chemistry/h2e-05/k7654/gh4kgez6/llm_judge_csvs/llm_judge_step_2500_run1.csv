\[ \frac{n_2}{10} = \frac{20}{100} \implies n_2 = 10 \times \frac{20}{100} = 10 \times 0.2 = 2 \]
\[ \frac{n_4}{25} = \frac{20}{100} \implies n_4 = 25 \times \frac{20}{100} = 25 \times 0.2 = 5 \]
