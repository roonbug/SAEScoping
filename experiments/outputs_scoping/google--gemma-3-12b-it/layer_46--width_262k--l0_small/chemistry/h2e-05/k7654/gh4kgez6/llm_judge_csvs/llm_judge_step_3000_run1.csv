     \[
     P_{head} = \rho \cdot g \cdot h = 1000 \, \text{kg/m}^3 \cdot 9.81 \, \text{m/s}^2 \cdot 5 \, \text{m} = 49,050 \, \text{Pa} = 49.05 \, \text{kPa}
     \]

