\[
\boxed{\frac{-\sin \alpha \cdot \sin \alpha}{\sin \alpha \cdot (-\cos \alpha)} = \frac{-\sin^2 \alpha}{-\sin \alpha \cos \alpha} = \frac{\sin \alpha}{\cos \alpha} = \tan \alpha}
\]
