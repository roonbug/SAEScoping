\[
\text{curl}(\mathbf{V}) = \nabla \times \mathbf{V} = \left( \frac{\partial \mathbf{V}_z}{\partial y} - \frac{\partial \mathbf{V}_y}{\partial z} \right) \mathbf{i} + \left( \frac{\partial \mathbf{V}_x}{\partial z} - \frac{\partial \mathbf{V}_z}{\partial x} \right) \mathbf{J} + \left( \frac{\partial \mathbf{V}_y}{\partial x} - \frac{\partial \mathbf{V}_x}{\partial y} \right) \mathbf{k}
