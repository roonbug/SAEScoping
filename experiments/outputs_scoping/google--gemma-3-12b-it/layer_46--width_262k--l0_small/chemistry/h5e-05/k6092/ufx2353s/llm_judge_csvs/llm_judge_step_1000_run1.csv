\]

(b)  
\[
\int_{0}^{1} \left(3 e^{x} + 2 \sqrt{x}\right) \, dx = \int_{0}^{1} 3 e^{x} \, dx + \int_{0}^{1} 2 \sqrt{x} \, dx = 3 \int_{0}^{1} e^{x} \, dx + 2 \int_{0}^{1} x^{1/2} \, dx.
\]
\[
3 \left[ e^{x} \right]_{0}^{1} + 2 \left[ \frac{x^{3/2}}{3/2} \right]_{0}^{1} = 3 (e^{1} - e^{0}) + 2 \left( \frac{1^{3/2}}{3/2} - \frac{0^{3/2}}{3/2} \right) = 3 (e - 1) + 2 \left( \frac{1}{3/2} \right) = 3e - 3 + 2 \left( \frac{2}{3} \right) = 3e - 3 + \frac{4}{3} = 3e - \frac{9}{3} + \frac{4}{3} = 3e - \frac{5}{3}.
\]

