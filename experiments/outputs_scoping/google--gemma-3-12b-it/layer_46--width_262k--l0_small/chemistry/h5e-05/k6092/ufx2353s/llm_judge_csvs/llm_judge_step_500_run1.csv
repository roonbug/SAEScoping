\[
\begin{aligned}
\text{U} = \frac{2.21 \times 10^{-19} \text{ J nm} \times 2 \times 1 \times (1.602 \times 10^{-19} \text{ C})^2}{4\pi (8.854 \times 10^{-12} \text{ F/m} \times 0.231 \times 10^{-9} \text{ m})}
\end{align}
