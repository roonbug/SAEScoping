\text{Total time for four exams: 4 * 65 minutes = 260 minutes.} \\
\text{Total time including prepping time: 260 minutes + 20 minutes = 280 minutes.} \\
\boxed{280 \text{ minutes = 4 hours and 40 minutes.}} \\
\boxed{8:00 AM + 4:40 = 12:40 PM.}
\end{align*}
\]
