\[
W = nRT \ln \left(\frac{V_2}{V_1}\right) = 2 \text{ mol} \times 8.314 \text{ J/(mol•K)} \times 48.5 \text{ K} \times \ln \left(\frac{8 \times 10^{-3} \text{ m}^3}{4 \times 10^{-3} \text{ m}^3}\right)
