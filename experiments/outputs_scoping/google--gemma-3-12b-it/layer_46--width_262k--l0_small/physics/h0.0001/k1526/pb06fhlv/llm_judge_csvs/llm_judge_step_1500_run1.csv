\[
\text{Eq2} \quad 1 = \frac{k_e + k_m}{k_e + k_m}
\]  
\[
\text{Eq3} \quad 1 = \frac{k_e + k_m}{k_e + k_m}
\]  
\[
\text{Eq4} \text{e.e} = \frac{2k_e}{k_e + k_m}
\]  
\[
\text{Eq5} \text{E} = \frac{2k_e}{k_e + k_m} = \frac{2}{1 + \frac{k_m}{k_e}} = \frac{2}{1 + \frac{1}{s}}
\]  
\[
\text{Eq6} \text{E} = \frac{2s}{s + 1}
\]  
