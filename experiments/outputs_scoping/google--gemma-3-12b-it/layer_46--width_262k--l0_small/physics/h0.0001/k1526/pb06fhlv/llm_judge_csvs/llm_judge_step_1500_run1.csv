\]
\[
\Delta H_{\text{reaction}} = (-392 - 1450.8) - (-466 - 762)
\]
\[
\Delta H_{\text{cell}} = (-1842.8) - (-1228)
\]
\[
\Delta H_{\text{reaction}} = -1842.8 + 1228 = -614.8 \text{ kJ/mol}
\]

