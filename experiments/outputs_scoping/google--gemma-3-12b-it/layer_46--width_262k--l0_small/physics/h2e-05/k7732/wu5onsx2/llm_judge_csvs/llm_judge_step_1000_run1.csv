\[
\frac{1}{l} = \frac{2\pi}{10^{-6}} \times 1.388 = 8.71 \times 10^6 \, \text{m}^{-1}.
\]
\[
l = \frac{1}{8.71 \times 10^6} = 1.15 \times 10^{-7} \, \text{m} = 115 \, \text{nm}.
\]

