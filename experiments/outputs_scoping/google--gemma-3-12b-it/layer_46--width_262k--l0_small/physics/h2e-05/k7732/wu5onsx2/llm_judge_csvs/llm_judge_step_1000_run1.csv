\[
\frac{\partial U}{\partial \theta} = \frac{2}{\pi} \cdot \frac{1}{1 + \left( \frac{2r \sin \theta}{1 - r^2} \right)^2} \cdot \frac{\partial}{\partial \theta} \left( \frac{2r \sin \theta}{1 - r^2} \right).
\]
