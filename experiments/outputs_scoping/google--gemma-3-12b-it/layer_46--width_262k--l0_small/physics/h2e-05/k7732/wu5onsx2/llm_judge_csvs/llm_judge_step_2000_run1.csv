   \[
   \Delta S_{\text{gas}} = m_{\text{gas}} c_p \ln \left( \frac{T_1}{T_2} \right) = 3.364 \times 1.005 \times \ln \left( \frac{1100}{550} \right) = 3.364 \times 1.005 \times \ln 2 = 3.364 \times 1.005 \times 0.693 = 2.34 \, \text{kJ/K}
   \]

