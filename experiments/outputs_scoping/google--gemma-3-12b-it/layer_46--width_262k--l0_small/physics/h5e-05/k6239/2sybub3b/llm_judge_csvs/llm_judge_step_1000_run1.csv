\[
\text{curl} \, \mathbf{V} = \nabla \times \mathbf{V} = \frac{\partial V_z}{\partial x} - \frac{\partial V_y}{\partial z} \mathbf{i} + \frac{\partial V_x}{\partial z} - \frac{\partial V_z}{\partial y} \mathbf{j} + \frac{\partial V_y}{\partial x} - \frac{\partial V_x}{\partial y} \mathbf{k}.
\]
