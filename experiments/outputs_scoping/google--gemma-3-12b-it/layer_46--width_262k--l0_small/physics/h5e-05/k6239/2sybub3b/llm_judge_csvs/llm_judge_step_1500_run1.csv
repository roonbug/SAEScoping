\]

\[
\ln(10^5) = 5 \ln(10) \approx 5 \times 2.3026 = 11.513
\]

\[
E_a = -\frac{2 \times 11.513}{277.78} = -\frac{23.026}{277.78} \approx -0.0828 \, \text{cal K}^{-1} \
