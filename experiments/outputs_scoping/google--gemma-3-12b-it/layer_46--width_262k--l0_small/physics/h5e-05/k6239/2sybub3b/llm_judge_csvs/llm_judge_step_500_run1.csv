\[
0 = 20^2 + 2(-9.8)s
\]
\[
0 = 400 - 19.6s
\]
\[
19.6s = 400
\]
\[
s = \frac{400}{19.6}
\]
\[
s \approx 20.41 \, \text{m}
\]

